# Copiá este archivo como .env y completá los valores. El .env NO se sube al repo.

# Obligatoria: LLM de los agentes (gratis en https://aistudio.google.com/apikey).
# También se usa para los embeddings de la consulta a Pinecone.
GOOGLE_API_KEY=

# Opcional: Vector DB de la Pre-entrega 4. Sin esta key, el Investigador usa solo BM25 local
# sobre el mismo corpus (data/).
PINECONE_API_KEY=
INDEX_NAME=fastapi-docs-rag
PINECONE_NAMESPACE=fastapi-docs

# Opcionales
GEMINI_MODEL=gemini-flash-lite-latest
# Límites anti "Supervisor Infinito"
MAX_PASOS=6
MAX_VISITAS_POR_AGENTE=2
